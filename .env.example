# Copy this file to bin/.env (or set CTF_AGENT_ENV_FILE) and replace placeholders.
# Never commit a real API key.

# Single-model configuration (default)
CTF_UPSTREAM_MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
CTF_UPSTREAM_MODEL_API_KEY=replace-with-your-api-key
CTF_MODEL_ID=your-model-id
CTF_MODEL_INCLUDE_STREAM_USAGE=true
CTF_MODEL_SUPPORTS_IMAGES=false

# Optional local daemon configuration
# CTF_DAEMON_ADDRESS=127.0.0.1:18731
# CTF_AGENT_DATA_DIR=./data
# CTF_DAEMON_TOKEN=replace-with-a-random-local-token

# Optional multi-model configuration. Uncomment this block only when using it;
# it takes precedence over the single-model configuration above.
# CTF_MODELS=deepseek,vision
# CTF_DEFAULT_MODEL=deepseek
# CTF_MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# CTF_MODEL_DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# CTF_MODEL_DEEPSEEK_ID=deepseek-chat
# CTF_MODEL_DEEPSEEK_SUPPORTS_IMAGES=false
# CTF_MODEL_VISION_BASE_URL=https://your-vision-endpoint/v1
# CTF_MODEL_VISION_API_KEY=replace-with-your-vision-key
# CTF_MODEL_VISION_ID=your-vision-model
# CTF_MODEL_VISION_SUPPORTS_IMAGES=true
